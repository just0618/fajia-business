--- /mnt/data/fajia_patch_work/styles.css	2026-08-06 10:49:06.000000000 +0000
+++ /mnt/data/fajia_arena_preview/styles.css	2026-08-08 03:24:54.655928157 +0000
@@ -866,3 +866,22 @@
   .brand-project--leecn .mini-placeholder-card{margin-top:9mm}
   .hero-quote-item cite{font-size:10.5pt;padding:1.5mm 3mm}
 }
+
+/* ===== ARENA HOMME+ editorial release ===== */
+.arena-feature-card{margin-top:24px}
+.arena-editorial-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;background:#171310}
+.arena-editorial-gallery figure{margin:0;min-width:0;background:#171310;border-right:1px solid rgba(255,255,255,.18)}
+.arena-editorial-gallery figure:last-child{border-right:0}
+.arena-editorial-gallery img{display:block;width:100%;aspect-ratio:690/892;object-fit:cover;object-position:center top}
+.editorial-source-link{display:inline-flex;align-items:center;margin-top:18px;color:var(--pink-deep);font-size:14px;font-weight:700;border-bottom:1px solid rgba(216,95,122,.35);padding-bottom:2px}
+.editorial-source-link:hover{color:#a9425d;border-bottom-color:currentColor}
+@media (max-width:600px){
+  .arena-feature-card{margin-top:18px}
+  .arena-editorial-gallery{grid-template-columns:repeat(3,minmax(0,1fr))}
+}
+@media print{
+  .arena-feature-card{break-inside:avoid-page!important}
+  .arena-editorial-gallery{grid-template-columns:repeat(3,1fr)!important;background:transparent!important}
+  .arena-editorial-gallery figure{border-right:1px solid rgba(255,255,255,.18);background:#171310}
+  .editorial-source-link{display:none!important}
+}
